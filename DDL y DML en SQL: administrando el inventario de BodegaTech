CREATE DATABASE BodegaTech;
---Sesion DDL---------
DROP TABLE IF EXISTS Inventario;

---CREAR TABLA INVENTARIO------
---En columna Id_producto se usa INT ya que es un numero entero---
---En columna nombre_producto se usa VARCHAR ya que es un texto de hasta 100 caracteres---
---Columna Precio_unitario se usa DECIMAL para numeos con decimales exactos---
CREATE TABLE Inventario(
Id_producto INT,
nombre_producto VARCHAR(100),
Categoria VARCHAR(100),
Precio_unitario DECIMAL (10,2),
Stock_actual INT,
Stock_minimo INT,
Fecha_ingreso DATE,
Activo TINYINT
);

